# Credentialed local data. These files are not included in the repository.
MS_CXR_DATA_ROOT=/path/to/ms-cxr-1.1.0
MIMIC_CXR_JPG_ROOT=/path/to/mimic-cxr-jpg

# Optional model/cache locations.
HF_HOME=/path/to/huggingface/cache
